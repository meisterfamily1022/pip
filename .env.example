# Pip environment template.
#
# Copy to .env.local and fill in real values. Never commit a filled-in copy.
# Outside production these may all be omitted: the app falls back to clearly
# marked development values so a fresh clone runs without setup.
#
# In production, PIP_SESSION_SECRET and PIP_ONE_TIME_SECRET are required and the
# server refuses to start without them.

# --- Supabase client configuration ------------------------------------------
#
# Both values are safe to embed in an Expo client. Use the Supabase Project URL
# and its publishable (or legacy anon) key. Never use a service_role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Optional lifetimes, in milliseconds ------------------------------------

# Default 30 days.
PIP_SESSION_LIFETIME_MS=
# Default 24 hours.
PIP_VERIFICATION_LIFETIME_MS=
# Default 1 hour.
PIP_RESET_LIFETIME_MS=
# How recently a password must have been confirmed before a sensitive action
# such as deleting an account. Default 10 minutes.
PIP_REAUTH_WINDOW_MS=

# --- Optional third-party sign-in -------------------------------------------
#
# Leave blank to hide the button entirely. Pip never shows a sign-in method it
# cannot complete.

PIP_APPLE_SIGN_IN_CLIENT_ID=
PIP_GOOGLE_SIGN_IN_CLIENT_ID=

# --- Email delivery ---------------------------------------------------------
#
# NOT YET WIRED TO A PROVIDER. Confirmation and password-reset flows are fully
# implemented against the MailSender interface in src/server/auth/mail.ts and are
# covered by tests, but no provider credential ships with this repository.
# Until one is configured, ConsoleMailSender logs that a message would have been
# sent and deliberately omits the address, code, and reset token.
#
# To go live: implement MailSender for your provider, set the values below, and
# select it where AuthService is constructed.

PIP_MAIL_PROVIDER_API_KEY=
PIP_MAIL_FROM_ADDRESS=
